//
//  ProceduralSurface.metal
//  RealityEsceneTestV3
//
//  A mesh whose vertices do not exist on the CPU.
//
//  LowLevelMesh hands out its vertex buffer as an MTLBuffer through
//  replace(bufferIndex:using:). This kernel writes every position and every
//  normal into it each frame, so the surface is generated by the same GPU that
//  is about to draw it. Nothing is uploaded; the only thing crossing from
//  Swift is the handful of floats in SurfaceParams.
//
//  Normals are computed analytically from the height field rather than by
//  averaging face normals: four extra height samples per vertex is cheaper
//  than a second pass over the triangles, and it leaves no seams.
//

#include <metal_stdlib>
using namespace metal;

// Mirrored by SurfaceParams in ProceduralSurface.swift.
struct SurfaceParams {
    uint  columns;
    uint  rows;
    float spacing;
    float time;
    float amplitude;
    float frequency;
    float speed;
    float cameraX;
    float cameraZ;
};

// 12 + 12 + 8 = 32 bytes, matching the stride the Swift descriptor declares.
struct SurfaceVertex {
    packed_float3 position;
    packed_float3 normal;
    packed_float2 uv;
};

// Three octaves of travelling swell, plus a ring that radiates from wherever
// the camera is standing so the surface reacts to the player.
static float surfaceHeight(float x, float z, constant SurfaceParams &p) {
    const float t = p.time * p.speed;

    float h = sin(x * p.frequency + t) * 0.55f;
    h += sin(z * p.frequency * 0.83f + t * 1.17f) * 0.35f;
    h += sin((x + z) * p.frequency * 1.9f - t * 0.6f) * 0.18f;

    // Camera ripple: strong nearby, gone by about eight metres out.
    const float dx = x - p.cameraX;
    const float dz = z - p.cameraZ;
    const float d  = sqrt(dx * dx + dz * dz);
    h += sin(d * 2.2f - t * 3.0f) * exp(-d * 0.22f) * 0.9f;

    return h * p.amplitude;
}

kernel void surface_vertices(
    device   SurfaceVertex *vertices [[buffer(0)]],
    constant SurfaceParams &params   [[buffer(1)]],
    uint                    index    [[thread_position_in_grid]])
{
    const uint total = params.columns * params.rows;
    if (index >= total) {
        return;
    }

    const uint row    = index / params.columns;
    const uint column = index % params.columns;

    const float halfX = float(params.columns) * 0.5f;
    const float halfZ = float(params.rows)    * 0.5f;

    const float x = (float(column) - halfX) * params.spacing;
    const float z = (float(row)    - halfZ) * params.spacing;

    const float y = surfaceHeight(x, z, params);

    // Central differences over one grid step give the slope in each axis; the
    // normal is the cross product of the two tangents, which for a height
    // field reduces to this.
    const float e  = params.spacing;
    const float hx = surfaceHeight(x + e, z, params) - surfaceHeight(x - e, z, params);
    const float hz = surfaceHeight(x, z + e, params) - surfaceHeight(x, z - e, params);
    const float3 normal = normalize(float3(-hx, 2.0f * e, -hz));

    vertices[index].position = packed_float3(x, y, z);
    vertices[index].normal   = packed_float3(normal);
    vertices[index].uv       = packed_float2(
        float(column) / float(params.columns - 1),
        float(row)    / float(params.rows    - 1)
    );
}
